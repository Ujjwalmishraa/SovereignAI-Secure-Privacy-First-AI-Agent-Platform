
FROM python:3.12-slim

# Create a dedicated non-root user and required directories
RUN useradd -u 10001 -m sandboxuser \
    && mkdir -p /app /jobs/in /jobs/out \
    && chown -R sandboxuser:sandboxuser /app /jobs

WORKDIR /app

# Copy only the sandbox execution files
COPY --chown=sandboxuser:sandboxuser sandbox.py .
COPY --chown=sandboxuser:sandboxuser sandbox_worker.py .

# Use the writable tmpfs mounted at /tmp by Docker Compose
ENV TMPDIR=/tmp
ENV TEMP=/tmp
ENV TMP=/tmp
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Run as non-root
USER 10001:10001

CMD ["python", "-u", "sandbox_worker.py"]
